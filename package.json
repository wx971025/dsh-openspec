{
  "name": "dsh-openspec",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness plugin that browses, previews, edits, and saves OpenSpec change Markdown files in the Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wx971025/dsh-openspec.git"
  },
  "bugs": {
    "url": "https://github.com/wx971025/dsh-openspec/issues"
  },
  "homepage": "https://github.com/wx971025/dsh-openspec#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openspec"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
